# Optional application settings (defaults apply when unset).
# APP_TITLE=Technical Debt Intelligence & Governance PoC
# API_V1_PREFIX=/api/v1
#
# Browser CORS allowed origins. pydantic-settings parses this as JSON.
# Use the Nuxt development origin when the frontend runs at http://localhost:3000.
# CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Required only for database operations and Alembic migrations.
# Use an untracked .env or process environment for real values.
#
# Windows Integrated Authentication example:
# Build an ODBC connection string, URL-encode it, and pass it as odbc_connect:
#   DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost\SQLEXPRESS;DATABASE=technical_debt_poc;Trusted_Connection=yes;
#   DATABASE_URL=mssql+pyodbc:///?odbc_connect=<url-encoded-odbc-connection-string>
#
# SQL authentication example (placeholders only):
#   DATABASE_URL=mssql+pyodbc://username:password@localhost%5CSQLEXPRESS/technical_debt_poc?driver=ODBC+Driver+17+for+SQL+Server
#
# DATABASE_CONNECTION_TIMEOUT_SECONDS=5
#
# Public GitHub Issues READ connector. These values identify a public demo
# repository and are not secrets. No token is used.
# GITHUB_REPOSITORY_OWNER=EminAksoy3427
# GITHUB_REPOSITORY_NAME=technical-debt-connector-demo
# GITHUB_REQUEST_TIMEOUT_SECONDS=5
#
# Bounded Day 5 demo GitHub issue TARGET identity used only to prepare an
# immutable ActionProposal preview. This is not write authority, not a token,
# not an executor, and not the GitHub READ connector repository.
# GITHUB_ISSUE_TARGET_REPOSITORY_OWNER=
# GITHUB_ISSUE_TARGET_REPOSITORY_NAME=
#
# Dedicated GitHub issue executor. The token remains server-owned and optional
# at startup; execution policy denies with zero network calls when it is absent.
# Never commit a real token.
# GITHUB_ISSUE_EXECUTOR_TOKEN=
# GITHUB_ISSUE_EXECUTOR_CONNECT_TIMEOUT_SECONDS=5
# GITHUB_ISSUE_EXECUTOR_REQUEST_TIMEOUT_SECONDS=15
#
# Bounded Agent Runtime operational limits. These limits cannot grant tool
# effects, risk levels, scopes, or approval.
# AGENT_MAX_ITERATIONS=6
# AGENT_MAX_TOOL_CALLS=3
# AGENT_RUN_TIMEOUT_SECONDS=60
# AGENT_TOOL_TIMEOUT_SECONDS=5
#
# Server-owned investigation provider. The deterministic provider is the
# default and requires no OpenAI configuration. The browser cannot select a
# provider or model. Set all three values explicitly to enable live inference.
# AGENT_PROVIDER=deterministic
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_REQUEST_TIMEOUT_SECONDS=30
#
# Development-only: opt into the fixed vertical-slice candidate population
# command (controlled Semgrep + seeded incidents). This is not the complete
# ingestion-source inventory. Default is false when unset. The command refuses
# to mutate the database unless this is explicitly true.
# ALLOW_DEVELOPMENT_DATA_POPULATION=true
#
# Local PoC Human Validation control seam. This is not enterprise
# authentication, SSO, or verified identity. Disabled by default. When
# enabled, the actor reference is server-owned opaque audit attribution.
# Clients cannot supply or override it. Do not put real credentials or
# personal identity here.
# HUMAN_GOVERNANCE_ENABLED=false
# HUMAN_GOVERNANCE_ACTOR_REFERENCE=poc:local-reviewer
#
# Local PoC L4 human action-execution capability seam. This is not a token.
# The dedicated executor must also be ready and policy must ALLOW.
# HUMAN_GOVERNANCE_ENABLED does not enable L4 approval or execution.
# HUMAN_ACTION_EXECUTION_ENABLED=false
