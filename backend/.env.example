# Optional application settings (defaults apply when unset).
# APP_TITLE=Technical Debt Intelligence & Governance PoC
# API_V1_PREFIX=/api/v1
#
# Browser CORS allowed origins. pydantic-settings parses this as JSON.
# Use the Nuxt development origin when the frontend runs at http://localhost:3000.
# CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Required only for database operations and Alembic migrations.
# Use an untracked .env or process environment for real values.
#
# Windows Integrated Authentication example:
# Build an ODBC connection string, URL-encode it, and pass it as odbc_connect:
#   DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost\SQLEXPRESS;DATABASE=technical_debt_poc;Trusted_Connection=yes;
#   DATABASE_URL=mssql+pyodbc:///?odbc_connect=<url-encoded-odbc-connection-string>
#
# SQL authentication example (placeholders only):
#   DATABASE_URL=mssql+pyodbc://username:password@localhost%5CSQLEXPRESS/technical_debt_poc?driver=ODBC+Driver+17+for+SQL+Server
#
# DATABASE_CONNECTION_TIMEOUT_SECONDS=5
#
# Development-only: opt into the fixed vertical-slice candidate population
# command (controlled Semgrep + seeded incidents). This is not the complete
# ingestion-source inventory. Default is false when unset. The command refuses
# to mutate the database unless this is explicitly true.
# ALLOW_DEVELOPMENT_DATA_POPULATION=true
